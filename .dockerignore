# Allow only application source and tests into the build context.
# Local databases, backups, Git metadata and credentials are excluded by default.
**
!Dockerfile
!.dockerignore
!main.py
!requirements/web.txt
!apartment_booking/
!apartment_booking/*.py
!apartment_booking/web/
!apartment_booking/web/*.py
!apartment_booking/web/templates/
!apartment_booking/web/templates/*.html
!apartment_booking/web/static/
!apartment_booking/web/static/*.css
!apartment_booking/web/static/*.js
!tests/
!tests/*.py
!tests/smoke/
!tests/smoke/*.py
# Never ship OS, interpreter or load-test files, even inside the allowed folders.
**/.DS_Store
**/__pycache__
**/*.py[cod]
tests/performance/
