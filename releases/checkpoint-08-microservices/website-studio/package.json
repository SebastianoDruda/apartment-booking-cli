{
  "name": "dimora-website-studio",
  "private": true,
  "description": "Dimora: web client for the Apartment Booking engine.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "python3 serve.py",
    "test": "node --test \"tests/**/*.test.js\" && python3 -m unittest discover -s tests -v",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0"
  }
}
